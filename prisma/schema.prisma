generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  url       String   @unique
  source    String
  createdAt DateTime @default(now())
}

model Airdrop {
  id        Int      @id @default(autoincrement())
  title     String
  url       String   @unique
  reward    String?
  network   String
  deadline  DateTime?
  createdAt DateTime @default(now())
}
